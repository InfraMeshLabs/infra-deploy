# InfraMesh Console deployment environment.
# Copy this file to .env before starting the stack.
# Never commit or share .env. Do not wrap values in quotes.
#
# Required values you MUST set before first start:
#   POSTGRES_PASSWORD
#   JWT_SECRET_KEY
#   ENCRYPTION_KEY
#   INFRA_ADMIN_PASSWORD
#
# All other values have defaults or are optional.
#
# Legend:
#   [Required]                 - no default; the stack refuses to start until it is set.
#   [Default: X]               - works as-is with X; change only if needed.
#   [Optional | Default: X]    - commented out; uncomment to change the default X.
#   [Optional]                 - only used by a specific feature.

# --------------------------------------------------
# InfraMesh Console
# --------------------------------------------------

# [Default: 0.1.1]
# Image tag of ghcr.io/inframeshlabs/infra-console. Pin a version for reproducible deployments.
INFRA_CONSOLE_VERSION=0.1.1

# [Default: 8080]
# Host port. The Console always listens on 8080 inside the container.
INFRA_CONSOLE_PORT=8080


# --------------------------------------------------
# PostgreSQL - database name is fixed to infra_mesh
# --------------------------------------------------

# [Default: inframesh]
# Must not be empty - Compose has no fallback for this value.
POSTGRES_USER=inframesh

# [Required]
# Used when the database volume is first created. Changing it later does not change the existing database password.
POSTGRES_PASSWORD=


# --------------------------------------------------
# InfraMesh Security
# --------------------------------------------------

# [Required]
# JWT signing key, Base64 string.
# Generate with: openssl rand -base64 48
JWT_SECRET_KEY=

# [Required]
# Encryption key for Team Keys / Node API Keys.
# Base64 of exactly 32 bytes.
# Generate with: openssl rand -base64 32
# Never change it once set - previously stored keys can no longer be decrypted.
ENCRYPTION_KEY=


# --------------------------------------------------
# Bootstrap Admin
# --------------------------------------------------

# [Default: admin]
# Created on first start only if no account with this username exists.
INFRA_ADMIN_USERNAME=admin

# [Required]
INFRA_ADMIN_PASSWORD=

# [Default: admin]
INFRA_ADMIN_NICKNAME=admin

# [Default: admin@infra-console.local]
INFRA_ADMIN_EMAIL=admin@infra-console.local


# --------------------------------------------------
# Session Affinity / Worker Capacity / Redis
# --------------------------------------------------

# [Default: false]
# Session Affinity: sends requests with the same sessionId to the same Worker. Needs Redis, so it is off by default.
# To use it, set this to true and start the stack with:  docker compose --profile affinity up -d
# Once enabled, each Team can still turn it on or off in its own settings.
INFRAMESH_SESSION_AFFINITY_ENABLED=false

# [Optional | Default: 30m]
# Session Affinity TTL. Only used when INFRAMESH_SESSION_AFFINITY_ENABLED=true.
#INFRAMESH_SESSION_AFFINITY_TTL=30m

# [Optional | Default: MEMORY]
# Worker capacity store (independent of Session Affinity).
#   MEMORY (default): kept in the Console's memory. No Redis needed. Accurate for a single Console instance only.
#   REDIS           : shared across Console instances. Needs Redis:  docker compose --profile redis up -d
#WORKER_CAPACITY_MODE=MEMORY

# [Optional]
# Redis password. Only used when Redis is enabled (INFRAMESH_SESSION_AFFINITY_ENABLED=true or WORKER_CAPACITY_MODE=REDIS).
# Empty = no authentication (Redis is not exposed outside the Compose network).
REDIS_PASSWORD=


# --------------------------------------------------
# Optional (defaults are used when unset)
# --------------------------------------------------

# [Optional | Default: http://localhost:<INFRA_CONSOLE_PORT>]
# Only needed when a frontend on a different origin calls the API.
#ALLOWED_ORIGIN_PATTERNS=

# Token lifetimes in milliseconds.
# [Optional | Default: 3600000] (1 hour)
#JWT_EXPIRATION=3600000
# [Optional | Default: 1209600000] (14 days)
#JWT_REFRESH_TOKEN_EXPRATION=1209600000

# OUTBOUND Node
# [Optional | Default: 60s]
#NODE_OUTBOUND_REQUEST_TIMEOUT=60s
# [Optional | Default: 30s]
#NODE_OUTBOUND_HEARTBEAT_TIMEOUT=30s
# [Optional | Default: 60s]
#NODE_OUTBOUND_STREAM_IDLE_TIMEOUT=60s
# [Optional | Default: 10m]
#NODE_REGISTRATION_TOKEN_TTL=10m

# Capacity
# [Optional | Default: 5m]
#WORKER_CAPACITY_INFLIGHT_TTL=5m

# Log retention. Every day at 03:00, logs older than the retention period are deleted batch-size rows at a time.
# [Optional | Default: true]
#AUDIT_RETENTION_ENABLED=true
# [Optional | Default: 180]
#AUDIT_RETENTION_DAYS=180
# [Optional | Default: 1000]
#AUDIT_RETENTION_BATCH_SIZE=1000
# [Optional | Default: true]
#REQUEST_LOG_RETENTION_ENABLED=true
# [Optional | Default: 30]
#REQUEST_LOG_RETENTION_DAYS=30
# [Optional | Default: 1000]
#REQUEST_LOG_RETENTION_BATCH_SIZE=1000
